/* A block comment
   before the version */
.version 8.8
.target sm_90
.address_size 64

.visible .entry k(.param .u64 a, .param .u32 f)
.maxntid 128, 1, 1
{
	.reg .pred %p<3>;
	.reg .b32 %r<6>;
	.reg .f32 %f<5>;
	.reg .b64 %rd<3>;
	ld.param.u64 %rd1, [a];
	ld.param.u32 %r1, [f];
	cvta.to.global.u64 %rd2, %rd1;
	setp.ne.u32 %p1, %r1, 0;
	setp.eq.u32 %p2, %r1, 7;
L1: @%p1 multimem.ld_reduce.relaxed.sys.global.add.u32 %r2, [%rd1];
	@!%p1 ld.global.u32 %r2, [%rd2];
	@!%p2 multimem.ld_reduce.relaxed.sys.global.add.v4.f32 {%f1, %f2, %f3, %f4}, [%rd1];
	@%p2 mov.f32 %f1, 0f3F800000;
	multimem.red.relaxed.sys.global.add.u32 [%rd1], %r2;
	cvt.rzi.u32.f32 %r3, %f1;
	add.u32 %r4, %r2, %r3;
	st.global.u32 [%rd2], %r4;
	ret;
}
