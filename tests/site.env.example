# Site-specific settings for the test suites.
# Copy this file to tests/site.env and edit it.  It is not tracked.
#
# Every variable already set in the environment wins (the `: "${VAR:=value}"` idiom).
# VF_TEST_ROOT is the one directory where the tests keep what they build and write, and under
# which they look for the programs they test.  Most defaults are under it.

# : "${VF_TEST_ROOT:=/path/to/your/cache}"
# (A path made of the machine's name, `$(hostname)`, is another path on each machine: on a second
# node of the same site the suites then look where nothing was put. Name the directory itself.)

# --- GPU test scripts (tests/gpu/) ---

# : "${VF_OUT:=$VF_TEST_ROOT}"
# : "${VF_PROXY:=$W/dist/lib}"
# : "${VF_JIT_CACHE:=$VF_TEST_ROOT/jit-cache}"
# : "${VF_NATIVE_LLAMA:=$VF_TEST_ROOT/llama-b12418-sm70/build/bin}"

# PyTorch 2.14.0+cu130 (stock wheel, sm_75 and later):
# : "${VF_TORCH:=$VF_TEST_ROOT/torch-cu130/site}"

# PyTorch 2.14.0+cu126 (native sm_70 build):
# : "${VF_TORCH_NATIVE:=$VF_TEST_ROOT/torch-cu126/site}"

# vLLM:
# : "${VF_VLLM_SITE:=$VF_TEST_ROOT/vllm/site}"
# : "${VF_VLLM_MODEL:=$VF_TEST_ROOT/models/Qwen2.5-0.5B-Instruct}"
# : "${VF_VLLM_EXTRA:=$VF_TEST_ROOT/vllm-extra/site}"
# : "${VF_VLLM_DEPS:=$VF_TEST_ROOT/vllm-deps/site}"

# SGLang:
# : "${VF_SGLANG_SITE:=$VF_TEST_ROOT/sglang/site}"
# : "${VF_MODEL:=$VF_TEST_ROOT/models/Qwen2.5-0.5B-Instruct}"
# : "${VF_CUTLASS_PREFIX:=$VF_TEST_ROOT/cutlass-prefix}"

# Python 3.12 headers (for Triton's C stub):
# : "${VF_PYTHON_DEV:=$VF_TEST_ROOT/python-dev}"

# ZML:
# : "${VF_ZML:=$VF_TEST_ROOT/zml/build}"
# : "${VF_ZML_MODEL:=$VF_TEST_ROOT/models/Qwen3.5-9B-AWQ-fp16-text}"

# --- SASS test scripts (tests/sass/) ---

# Directory of PyTorch cubins extracted by `vf extract`:
# : "${TORCH:=$VF_TEST_ROOT/torch-cubins}"
