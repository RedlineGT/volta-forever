.version 8.0
.target sm_75
.address_size 64
.visible .entry k(.param .u64 output) {
    .reg .b64 out;
    .reg .b32 lane, block, a, b;
    .reg .f32 d<4>;
    .reg .pred active;
    ld.param.u64 out, [output];
    mov.u32 block, %ctaid.x;
    mov.u32 lane, %tid.x;
    mad.wide.u32 out, lane, 16, out;
    setp.eq.u32 active, block, 0;
    mov.b32 a, 0x3c003c00;
    mov.b32 b, 0x3c003c00;
    mov.f32 d0, 0f40400000;
    mov.f32 d1, 0f40800000;
    mov.f32 d2, 0f40a00000;
    mov.f32 d3, 0f40c00000;
    @!active bra done;
    mma.sync.aligned.m16n8k8.row.col.f32.f16.f16.f32 {d0,d1,d2,d3}, {a,a}, {b}, {d0,d1,d2,d3};
done:
    st.global.v4.f32 [out], {d0,d1,d2,d3};
    ret;
}
