.version 8.8
.target sm_80
.address_size 64

.visible .entry k(.param .u64 output) {
.reg .u64 %out, %offset;
.reg .b32 %lane, %a, %a0, %b, %d<4>, %check<4>, %expected;
.reg .pred %first, %row0;
ld.param.u64 %out, [output];
mov.u32 %lane, %laneid;
mul.wide.u32 %offset, %lane, 16;
add.u64 %out, %out, %offset;
mov.b32 %a, 0x3fc03fc0;
mov.b32 %a0, %a;
mov.b32 %b, 0x3f003f00;
// Four products of 16 terms of 1.5 * 0.5, accumulated in FP32.
mov.b32 %d0, 0;
mov.b32 %d1, 0;
mov.b32 %d2, 0;
mov.b32 %d3, 0;
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
st.global.b32 [%out], %d0;
xor.b32 %check0, %d0, 0x42400000;
xor.b32 %check1, %d1, 0x42400000;
xor.b32 %check2, %d2, 0x42400000;
xor.b32 %check3, %d3, 0x42400000;
or.b32 %check0, %check0, %check1;
or.b32 %check2, %check2, %check3;
or.b32 %check0, %check0, %check2;
xor.b32 %check0, %check0, 0x5aa55aa5;
st.global.b32 [%out+4], %check0;

// A[0,0] becomes 2^17 in only lane 0. This must send the entire warp to the scalar path.
// Row zero becomes 4 * (2^17 + 15 * 1.5) * 0.5; the other fifteen rows remain 48.
setp.eq.u32 %first, %lane, 0;
selp.b32 %a0, 0x3fc04800, %a, %first;
mov.b32 %d0, 0;
mov.b32 %d1, 0;
mov.b32 %d2, 0;
mov.b32 %d3, 0;
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%d0,%d1,%d2,%d3}, {%a0,%a,%a,%a}, {%b,%b}, {%d0,%d1,%d2,%d3};
setp.lt.u32 %row0, %lane, 4;
selp.b32 %expected, 0x488005a0, 0x42400000, %row0;
xor.b32 %check0, %d0, %expected;
xor.b32 %check1, %d1, %expected;
xor.b32 %check2, %d2, 0x42400000;
xor.b32 %check3, %d3, 0x42400000;
or.b32 %check0, %check0, %check1;
or.b32 %check2, %check2, %check3;
or.b32 %check0, %check0, %check2;
xor.b32 %check0, %check0, 0x12345678;
st.global.b32 [%out+8], %check0;
ret;
}
