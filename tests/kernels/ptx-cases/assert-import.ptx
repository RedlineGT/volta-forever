.version 8.0
.target sm_80
.address_size 64
// A device assertion, as in Triton's bounds checks: the module calls __assertfail, which the
// driver provides. The condition never holds; every lane stores a signature.
.extern .func __assertfail
(
    .param .b64 __assertfail_param_0,
    .param .b64 __assertfail_param_1,
    .param .b32 __assertfail_param_2,
    .param .b64 __assertfail_param_3,
    .param .b64 __assertfail_param_4
)
.noreturn;
.global .align 1 .b8 message[6] = {102, 97, 108, 115, 101, 0};
.visible .entry k(.param .u64 output) {
    .reg .pred never;
    .reg .u32 lane;
    .reg .b64 out, text;
    mov.u32 lane, %tid.x;
    setp.ge.u32 never, lane, 1024;
    @!never bra store;
    mov.u64 text, message;
    cvta.global.u64 text, text;
    {
        .param .b64 p0;
        .param .b64 p1;
        .param .b32 p2;
        .param .b64 p3;
        .param .b64 p4;
        st.param.b64 [p0], text;
        st.param.b64 [p1], text;
        st.param.b32 [p2], 1;
        st.param.b64 [p3], text;
        st.param.b64 [p4], 1;
        call.uni __assertfail, (p0, p1, p2, p3, p4);
    }
store:
    ld.param.u64 out, [output];
    mad.wide.u32 out, lane, 16, out;
    st.global.v4.b32 [out], {0x12345678, 0x9abcdef0, 0x0badf00d, 0x00c0ffee};
    ret;
}
