.version 8.0
.target sm_90
.address_size 64
.file 1 "same-line-location.cu"

.visible .entry k(.param .u64 output) .reqntid 32,1,1
{
    .reg .b32 %a, %b, %c, %d, %lane;
    .reg .b64 %out;
    mov.b32 %a, 0x43004300;
    mov.b32 %b, 0xbf80bf80;
    mov.b32 %c, 0x43004300;
    // This move and the FMA compute 0 * (-1) + 128 in each packed BF16 lane.
    .loc 1 3 0 mov.b32 %a, 0;
    fma.rn.bf16x2 %d, %a, %b, %c;
    ld.param.u64 %out, [output];
    mov.u32 %lane, %laneid;
    mad.wide.u32 %out, %lane, 16, %out;
    st.global.v4.b32 [%out], {%d,%d,%d,%d};
    ret;
}
